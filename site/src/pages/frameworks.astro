---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import yaml from 'js-yaml';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const read = (f) => yaml.load(fs.readFileSync(`../data/frameworks/${f}`, 'utf8')).mappings;
const frameworks = [
  { id: 'nist-800-53', name: 'NIST 800-53', map: read('nist-800-53.yaml') },
  { id: 'iso-27001-2022', name: 'ISO 27001:2022', map: read('iso-27001-2022.yaml') },
  { id: 'soc2', name: 'SOC 2', map: read('soc2.yaml') },
];
---
<Base title="Frameworks">
  <h1 class="text-3xl font-extrabold">Frameworks</h1>
  <p class="mt-1 text-sm text-slate-600">Pick a framework and jump to the mapped control domains.</p>
  <div class="grid lg:grid-cols-3 gap-5 mt-6 items-start">
    {frameworks.map(fw => (
      <section class="card overflow-hidden">
        <h2 class="px-5 py-4 font-bold border-b border-slate-200 bg-slate-50">{fw.name}</h2>
        <table class="min-w-full text-sm">
          <tbody>
            {Object.entries(fw.map).map(([control, ids]) => (
              <tr class="border-t border-slate-100">
                <td class="px-4 py-2.5"><a class="link" href={`${base}controls/${control}`}>{control}</a></td>
                <td class="px-4 py-2.5 text-right text-xs font-semibold text-slate-500">{(ids as string[]).join(', ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
  </div>
</Base>