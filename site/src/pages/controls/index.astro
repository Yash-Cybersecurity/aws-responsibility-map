---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const entries = await getCollection('entries');
const controls = [...new Set(entries.map(e => e.data.control_domain))].sort();
---
<Base title="Controls">
  <h1 class="text-xl font-bold mb-4">Control domains</h1>
  <ul class="list-disc pl-6">
    {controls.map(c => <li><a href={`/controls/${c}`} class="underline">{c}</a></li>)}
  </ul>
</Base>