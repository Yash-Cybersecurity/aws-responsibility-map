---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getCollection } from 'astro:content';
const entries = await getCollection('entries');
const services = [...new Set(entries.map(e => e.data.service))].sort();
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const NAME: Record<string, string> = { s3: 'Amazon S3', ec2: 'Amazon EC2', iam: 'AWS IAM', rds: 'Amazon RDS', bedrock: 'Amazon Bedrock' };
---
<Base title="Services">
  <h1 class="text-3xl font-extrabold">Services</h1>
  <p class="mt-1 text-sm text-slate-600">Service-first answers: what you must configure, then every control with its owner.</p>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-6">
    {services.map(s => {
      const list = entries.filter(e => e.data.service === s);
      const counts = {};
      list.forEach(e => { counts[e.data.overall] = (counts[e.data.overall] || 0) + 1; });
      return (
        <a href={`${base}services/${s}`} class="card p-6 hover:border-slate-300 transition">
          <h2 class="text-lg font-bold">{NAME[s] || s}</h2>
          <p class="mt-1 text-sm text-slate-600">{list.length} control{list.length === 1 ? '' : 's'}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {Object.entries(counts).map(([k, n]) => <span class="inline-flex items-center gap-1"><StatusBadge value={k} size="sm" /><span class="text-xs text-slate-500">{n}</span></span>)}
          </div>
        </a>
      );
    })}
  </div>
</Base>