---
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const entries = (await getCollection('entries')).sort((a, b) => (b.data.review.reviewed_on || '').localeCompare(a.data.review.reviewed_on || ''));
const NAME: Record<string, string> = { s3: 'Amazon S3', ec2: 'Amazon EC2', iam: 'AWS IAM', rds: 'Amazon RDS', bedrock: 'Amazon Bedrock' };
const SHORT: Record<string, string> = {
  'encryption-at-rest': 'Encryption at rest', 'encryption-in-transit': 'Encryption in transit',
  'key-management': 'Key management', 'identity-and-access': 'Identity and access',
  'network-exposure': 'Network exposure', 'logging-and-monitoring': 'Logging and monitoring',
  'patching': 'Patching', 'backup-and-recovery': 'Backup and recovery',
  'data-classification': 'Data classification', 'vulnerability-management': 'Vulnerability management',
  'physical-security': 'Physical security', 'incident-response': 'Incident response',
  'configuration-management': 'Configuration management', 'prompt-and-data-handling': 'Prompts and data handling',
  'guardrails-and-output-filtering': 'Guardrails and output filtering',
  'model-weights-and-safety': 'Model weights and safety', 'model-output-liability': 'Model output liability',
  'availability-and-resilience': 'Availability and resilience', 'data-retention': 'Data retention', 'data-residency': 'Data residency',
};
---
<Base title="What changed">
  <h1 class="text-3xl font-extrabold">What changed</h1>
  <p class="mt-1 text-sm text-slate-600">Reverse-chronological review history. Automated snapshot changes open a PR; humans approve every merge.</p>
  <div class="card mt-6 divide-y divide-slate-100">
    {entries.map(e => (
      <div class="px-5 py-4 flex flex-wrap items-center gap-3 text-sm">
        <span class="text-slate-500 w-24 shrink-0">{e.data.review.reviewed_on}</span>
        <a class="link font-medium" href={`${base}services/${e.data.service}`}>{NAME[e.data.service] || e.data.service}</a>
        <span class="text-slate-400">·</span>
        <a class="text-slate-700 hover:underline" href={`${base}controls/${e.data.control_domain}`}>{SHORT[e.data.control_domain] || e.data.control_domain}</a>
        <span class="ml-auto"><StatusBadge value={e.data.overall} size="sm" /></span>
      </div>
    ))}
  </div>
</Base>