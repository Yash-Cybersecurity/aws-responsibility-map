---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const entries = await getCollection('entries');
const services = [...new Set(entries.map(e => e.data.service))].sort();
const controls = [...new Set(entries.map(e => e.data.control_domain))].sort();
const lookup = new Map(entries.map(e => [e.data.service + '|' + e.data.control_domain, e.data.overall]));
const color = { aws:'bg-blue-100 text-blue-800', customer:'bg-orange-100 text-orange-800', shared:'bg-purple-100 text-purple-800', model_provider:'bg-green-100 text-green-800', not_stated:'bg-gray-100 text-gray-500' };
---
<Base title="Matrix">
  <h1 class="text-xl font-bold mb-4">Responsibility matrix</h1>
  <div class="overflow-x-auto">
    <table class="min-w-full border text-sm">
      <thead>
        <tr>
          <th class="border p-2 sticky left-0 bg-white">Service</th>
          {controls.map(c => <th class="border p-2">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {services.map(s => (
          <tr>
            <td class="border p-2 font-semibold sticky left-0 bg-white">{s}</td>
            {controls.map(c => {
              const v = lookup.get(s+'|'+c) || 'not_stated';
              return <td class={`border p-2 ${color[v]}`}>{v}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-sm"><a href="/legend" class="underline">Legend</a></p>
</Base>