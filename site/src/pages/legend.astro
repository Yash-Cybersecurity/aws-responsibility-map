---
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
const rows = [
  ['aws', 'AWS performs and secures it.'],
  ['customer', 'The customer configures or performs it.'],
  ['shared', 'Both have a part; the split is explained in the entry.'],
  ['model_provider', 'The third-party model vendor (AI services only).'],
  ['not_stated', 'The documentation does not say. We never guess.'],
];
---
<Base title="Legend">
  <h1 class="text-3xl font-extrabold">Legend</h1>
  <p class="mt-1 text-sm text-slate-600">One vocabulary across the whole site. Honest uncertainty is a trust feature.</p>
  <div class="card mt-6 divide-y divide-slate-100">
    {rows.map(([v, d]) => (
      <div class="flex items-center gap-4 px-5 py-4">
        <StatusBadge value={v} />
        <span class="text-sm text-slate-600">{d}</span>
      </div>
    ))}
  </div>
</Base>