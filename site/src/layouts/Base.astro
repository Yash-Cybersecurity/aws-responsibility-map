---
import '../styles/global.css';
const { title = 'AWS Shared Responsibility Reference' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    <header class="border-b p-4">
      <nav class="flex gap-4">
        <a href={base} class="font-bold">AWS Responsibility Map</a>
        <a href={`${base}matrix`}>Matrix</a>
        <a href={`${base}services`}>Services</a>
        <a href={`${base}controls`}>Controls</a>
        <a href={`${base}changes`}>Changes</a>
        <a href={`${base}about`}>About</a>
      </nav>
      <p class="text-xs text-gray-500 mt-2">Unofficial community project. Not affiliated with or endorsed by AWS.</p>
    </header>
    <main class="p-4 max-w-6xl mx-auto">
      <slot />
    </main>
    <footer class="border-t p-4 text-xs text-gray-500">
      Unofficial community project. Not affiliated with or endorsed by AWS. AWS documentation and AWS Artifact are authoritative.
    </footer>
  </body>
</html>