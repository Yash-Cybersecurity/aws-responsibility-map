---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<Base title="Evaluation">
  <h1 class="text-3xl font-extrabold">Evaluation</h1>
  <p class="mt-1 text-sm text-slate-600">The hand-written entries are the gold set. The drafting pipeline is scored against them blind.</p>
  <div class="card mt-6 overflow-hidden">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 border-b border-slate-200"><tr><th class="th">Metric</th><th class="th">Result</th></tr></thead>
      <tbody>
        <tr class="border-t border-slate-100"><td class="td">Overall accuracy (gold set)</td><td class="td font-semibold">4 / 4 = 100%</td></tr>
        <tr class="border-t border-slate-100"><td class="td">Quote validity</td><td class="td">Validated verbatim</td></tr>
        <tr class="border-t border-slate-100"><td class="td">Hallucination rate</td><td class="td">0 unsourced quotes shipped</td></tr>
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-sm text-slate-600">Model: <code>llama3.1:8b</code> via Ollama. Prompt version: v0.1. Results are re-run when the model or prompt changes.</p>
  <a class="mt-4 inline-block text-sm font-semibold underline decoration-slate-300 underline-offset-2" href={`${base}about`}>Back to About →</a>
</Base>