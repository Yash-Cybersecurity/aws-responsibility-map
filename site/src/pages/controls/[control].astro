---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const entries = await getCollection('entries');
  const controls = [...new Set(entries.map(e => e.data.control_domain))];
  return controls.map(c => ({ params: { control: c } }));
}
const { control } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const entries = (await getCollection('entries')).filter(e => e.data.control_domain === control);
---
<Base title={control}>
  <h1 class="text-xl font-bold mb-4">{control}</h1>
  <table class="min-w-full border text-sm">
    <thead><tr><th class="border p-2">Service</th><th class="border p-2">Owner</th></tr></thead>
    <tbody>
      {entries.map(e => (
        <tr>
          <td class="border p-2"><a href={`${base}services/${e.data.service}`} class="underline">{e.data.service}</a></td>
          <td class="border p-2">{e.data.overall}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>