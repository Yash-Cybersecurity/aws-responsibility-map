---
import Base from '../layouts/Base.astro';
---
<Base title="Legend">
  <h1 class="text-xl font-bold mb-4">Legend</h1>
  <ul class="list-disc pl-6">
    <li><strong>aws</strong> — AWS performs and secures it.</li>
    <li><strong>customer</strong> — The customer configures or performs it.</li>
    <li><strong>shared</strong> — Both have a part; the split is explained in the entry.</li>
    <li><strong>model_provider</strong> — The third-party model vendor (AI services only).</li>
    <li><strong>not_stated</strong> — The documentation does not say. We never guess.</li>
  </ul>
</Base>