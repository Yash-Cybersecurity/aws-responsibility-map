---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import yaml from 'js-yaml';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const glossary = yaml.load(fs.readFileSync('../data/vendor/glossary.yaml', 'utf8')).terms;
const questions = yaml.load(fs.readFileSync('../data/vendor/questions.yaml', 'utf8')).questions;
---
<Base title="Vendor view">
  <h1 class="text-xl font-bold mb-2">Vendor view</h1>
  <p class="mb-4">Building on AWS and answering customer security questionnaires? Use three columns: <strong>AWS</strong>, <strong>You (the vendor)</strong>, and <strong>Your customers</strong>. The dataset fills the first two; the third is yours to complete.</p>
  <h2 class="font-semibold mt-6 mb-2">Common customer questions</h2>
  <ul class="list-disc pl-6">
    {questions.map(q => <li>{q.text} <span class="text-xs text-gray-500">({q.tags.join(', ')})</span></li>)}
  </ul>
  <h2 class="font-semibold mt-6 mb-2">Glossary</h2>
  <dl class="space-y-2">
    {glossary.map(g => (
      <div>
        <dt class="font-semibold">{g.term}</dt>
        <dd>{g.meaning} <em class="text-sm text-gray-500">e.g. {g.example}</em></dd>
      </div>
    ))}
  </dl>
  <h2 class="font-semibold mt-6 mb-2">Export</h2>
  <p>Download the current dataset: <a class="underline" href={`${base}data/export.csv`}>CSV</a> · <a class="underline" href={`${base}data/index.json`}>JSON</a></p>
  <p class="mt-4 text-xs font-semibold">Unofficial, not an AWS statement. Verify against AWS documentation before submitting.</p>
</Base>