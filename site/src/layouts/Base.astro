---
import '../styles/global.css';
const { title = 'Responsibility Map' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const nav = [
  ['Services', 'services'],
  ['Matrix', 'matrix'],
  ['Changes', 'changes'],
  ['Search', 'search'],
  ['About', 'about'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Unofficial, sourced and change-tracked AWS shared responsibility reference: who owns each security control, by service and by control." />
    <title>{title} · Responsibility Map</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="bg-white border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-5 py-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
        <a href={base} class="flex items-center gap-2.5 shrink-0">
          <span class="w-7 h-7 rounded-md bg-slate-900 inline-flex items-center justify-center">
            <span class="w-2.5 h-2.5 rounded-[2px] bg-white"></span>
          </span>
          <span class="text-lg font-bold tracking-tight">Responsibility Map</span>
        </a>
        <nav class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm font-medium text-slate-700">
          {nav.map(([label, slug]) => <a href={`${base}${slug}`} class="hover:text-slate-950">{label}</a>)}
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <div class="max-w-6xl mx-auto px-5 py-10">
        <slot />
      </div>
    </main>

    <footer class="border-t border-slate-200 bg-white">
      <div class="max-w-6xl mx-auto px-5 py-6 text-xs leading-relaxed text-slate-500">
        Unofficial community project, not affiliated with AWS. AWS documentation and AWS Artifact are authoritative. Not audit or legal advice.
      </div>
    </footer>
  </body>
</html>