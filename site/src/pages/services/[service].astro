---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  const services = [...new Set(entries.map(e => e.data.service))];
  return services.map(s => ({ params: { service: s } }));
}
const { service } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const all = (await getCollection('entries')).filter(e => e.data.service === service);
const NAME: Record<string, string> = { s3: 'Amazon S3', ec2: 'Amazon EC2', iam: 'AWS IAM', rds: 'Amazon RDS', bedrock: 'Amazon Bedrock' };
const SHORT: Record<string, string> = {
  'encryption-at-rest': 'Encryption at rest', 'encryption-in-transit': 'Encryption in transit',
  'key-management': 'Key management', 'identity-and-access': 'Identity and access',
  'network-exposure': 'Network exposure', 'logging-and-monitoring': 'Logging and monitoring',
  'patching': 'Patching', 'backup-and-recovery': 'Backup and recovery',
  'data-classification': 'Data classification', 'vulnerability-management': 'Vulnerability management',
  'physical-security': 'Physical security', 'incident-response': 'Incident response',
  'configuration-management': 'Configuration management', 'prompt-and-data-handling': 'Prompts and data handling',
  'guardrails-and-output-filtering': 'Guardrails and output filtering',
  'model-weights-and-safety': 'Model weights and safety',
  'model-output-liability': 'Model output liability',
  'availability-and-resilience': 'Availability and resilience',
  'data-retention': 'Data retention',
  'data-residency': 'Data residency',
};
const LAYER: Record<string, string> = {
  infra: 'Infrastructure and platform', model: 'Model weights and base safety', data: 'Prompts, RAG data and training data',
  application: 'Guardrails, access and application', governance: 'Logging, privacy and oversight',
};
const isAI = service === 'bedrock';
const reviewedCount = all.filter(e => e.data.review.status === 'human_reviewed').length;
const actions = all.flatMap(e => (e.data.customer_actions || []).map((a: any) => ({ ...a, control: e.data.control_domain })));
const layered = all.filter(e => e.data.layer && e.data.deployment_scope);
const LAYER_ORDER = ['infra', 'model', 'data', 'application', 'governance'];
const layers = LAYER_ORDER.filter(l => layered.some(e => e.data.layer === l));
const scopes = [
  ['genai-scope-1', 'Scope 1-2 · Buy an AI app'],
  ['genai-scope-3', 'Scope 3 · Use a model as is'],
  ['genai-scope-4', 'Scope 4 · Fine-tune a model'],
  ['genai-scope-5', 'Scope 5 · Train your own'],
];
const panelData = Object.fromEntries(all.map(e => [e.data.control_domain, {
  name: SHORT[e.data.control_domain] || e.data.control_domain,
  overall: e.data.overall,
  aws: e.data.responsibility?.aws || null,
  customer: e.data.responsibility?.customer || null,
  modelProvider: e.data.responsibility?.model_provider || null,
  quote: e.data.sources?.[0]?.quote || null,
  url: e.data.sources?.[0]?.url || null,
  retrieved: e.data.sources?.[0]?.retrieved || null,
  reviewed: e.data.review?.reviewed_on || null,
  rationale: e.data.review?.rationale || null,
}]));
---
<Base title={NAME[service] || service}>
  <nav class="text-sm text-slate-500 mb-2">
    <a href={`${base}services`} class="hover:text-slate-800">Services</a>
    <span class="mx-1.5">›</span>
    <span class="text-slate-700">{NAME[service] || service}</span>
    {isAI && <><span class="mx-1.5">›</span><span class="text-slate-700">Scope 3</span></>}
  </nav>

  <h1 class="text-4xl font-extrabold">{NAME[service] || service}</h1>
  <p class="mt-2 text-slate-600 max-w-2xl">{all.length} control entries, {reviewedCount} human-reviewed. Every owner claim carries a source, a short quote and a review date.</p>

  {actions.length > 0 && (
    <section class="card p-5 mt-6 border-l-4 border-l-orange-400">
      <h2 class="font-bold">Your checklist</h2>
      <p class="text-sm text-slate-600 mt-1">What the customer must configure for {NAME[service] || service}.</p>
      <ul class="mt-3 space-y-1.5 text-sm">
        {actions.map(a => <li class="flex gap-2"><span class="text-orange-500">●</span><span><strong>{SHORT[a.control] || a.control}:</strong> {a.type === 'config_rule' ? `AWS Config rule ${a.id}` : a.path || a.type}</span></li>)}
      </ul>
    </section>
  )}

  {isAI && layered.length > 0 && (
    <section class="mt-8">
      <h2 class="font-bold">How are you using it?</h2>
      <div id="scopes" class="mt-3 flex flex-wrap gap-2">
        {scopes.map(([id, label], i) => (
          <button data-scope={id} class={`rounded-lg border px-4 py-2 text-sm font-semibold ${i === 1 ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 bg-white text-slate-700'}`}>{label}</button>
        ))}
      </div>
      <div class="mt-3 flex items-center gap-3 text-sm text-slate-600">
        <span>Your ownership grows with scope:</span>
        <span class="flex gap-1" id="meter">{[1,2,3,4,5].map(n => <span class={`h-1.5 w-8 rounded-full ${n <= 3 ? 'bg-slate-900' : 'bg-slate-300'}`}></span>)}</span>
        <span id="scopeLabel">Scope 3 of 5</span>
      </div>

      <div class="mt-5 space-y-2">
        {layers.map(layer => (
          <div class="card px-5 py-4 grid sm:grid-cols-[1fr_auto_1.4fr] gap-3 items-center" data-layer={layer}>
            <div class="font-semibold">{LAYER[layer] || layer}</div>
            <div>{(() => { const e = layered.filter(x => x.data.layer === layer).sort((a,b) => (a.data.deployment_scope || '').localeCompare(b.data.deployment_scope || ''))[0]; return <StatusBadge value={e?.data.overall || 'not_stated'} size="sm" />; })()}</div>
            <div class="text-sm text-slate-600">{layered.filter(x => x.data.layer === layer)[0]?.data.responsibility?.customer || 'What this means for you: see the entry for the quoted split.'}</div>
          </div>
        ))}
      </div>
      <p class="mt-4 text-xs text-slate-500">Legend: <StatusBadge value="aws" size="sm" /> <StatusBadge value="model_provider" size="sm" /> <StatusBadge value="customer" size="sm" /> <StatusBadge value="shared" size="sm" /> <StatusBadge value="not_stated" size="sm" /></p>
      <p class="mt-2 text-xs text-slate-500">Every real cell shows its source, quote and review date. Liability for model output is a contract question, not a technical control.</p>
    </section>
  )}

  <section class="mt-8">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-3">
      <h2 class="text-xl font-bold">All controls</h2>
      <p class="text-xs text-slate-500">Select an owner badge to see the AWS and customer responsibilities for that control.</p>
    </div>
    <div class="grid lg:grid-cols-[1fr_340px] gap-6 items-start">
      <div class="card overflow-hidden">
        <div class="overflow-x-auto">
          <table id="controls-table" class="min-w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
              <tr><th class="th">Control</th><th class="th">Owner</th><th class="th">Review</th><th class="th">Frameworks</th></tr>
            </thead>
            <tbody>
              {all.map(e => (
                <tr class="border-t border-slate-100 align-top">
                  <td class="td"><span class="font-medium">{SHORT[e.data.control_domain] || e.data.control_domain}</span></td>
                  <td class="td">
                    <button type="button" data-detail={e.data.control_domain} aria-controls="detail-panel" aria-label={`Show AWS and customer responsibilities for ${SHORT[e.data.control_domain] || e.data.control_domain}`} class="cursor-pointer rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-900">
                      <StatusBadge value={e.data.overall} size="sm" />
                    </button>
                  </td>
                  <td class="td text-slate-600">{e.data.review.status === 'human_reviewed' ? 'Reviewed' : e.data.review.status} {e.data.review.reviewed_on}</td>
                  <td class="td text-xs text-slate-500">
                    {[...(e.data.frameworks?.nist_800_53 || []).map((x: string) => 'NIST ' + x), ...(e.data.frameworks?.iso_27001_2022 || []).map((x: string) => 'ISO ' + x), ...(e.data.frameworks?.soc2 || []).map((x: string) => 'SOC 2 ' + x)].join(' · ') || '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <aside id="detail-panel" class="card p-5 lg:sticky lg:top-6" aria-live="polite">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Responsibility details</p>
        <p class="mt-2 text-sm text-slate-600">Select any owner badge for {NAME[service] || service} to see what AWS owns, what you own, and the source behind each claim.</p>
      </aside>
    </div>
  </section>

  <section class="mt-8">
    <details class="card p-5">
      <summary class="cursor-pointer font-semibold">Full entries <span class="font-normal text-slate-500">— every control with its source, quote and review date</span></summary>
      <div class="mt-4 divide-y divide-slate-100">
        {all.map(e => (
          <div class="py-4 first:pt-0 last:pb-0">
            <p class="font-semibold flex items-center gap-3 flex-wrap">{SHORT[e.data.control_domain] || e.data.control_domain} <StatusBadge value={e.data.overall} size="sm" /></p>
            <div class="mt-3 space-y-2 text-sm">
              <p><strong>AWS:</strong> {e.data.responsibility?.aws ?? '—'}</p>
              <p><strong>You:</strong> {e.data.responsibility?.customer ?? '—'}</p>
              {e.data.responsibility?.model_provider && <p><strong>Model provider:</strong> {e.data.responsibility.model_provider}</p>}
              {e.data.sources?.[0] && (
                <blockquote class="border-l-2 border-slate-300 pl-3 italic text-slate-600">“{e.data.sources[0].quote}”</blockquote>
              )}
              {e.data.sources?.[0] && (
                <p class="text-xs text-slate-500">Source: <a class="link" href={e.data.sources[0].url} target="_blank" rel="noopener">{e.data.sources[0].url}</a> · Retrieved {e.data.sources[0].retrieved} · Reviewed {e.data.review.reviewed_on}</p>
              )}
              {e.data.review?.rationale && <p class="text-xs italic text-slate-500">{e.data.review.rationale}</p>}
            </div>
          </div>
        ))}
      </div>
    </details>
  </section>

  {isAI && (
    <script define:vars={{ base }}>
      const scopeToLevel = { 'genai-scope-1': 2, 'genai-scope-2': 2, 'genai-scope-3': 3, 'genai-scope-4': 4, 'genai-scope-5': 5 };
      const buttons = [...document.querySelectorAll('#scopes button')];
      function setScope(id) {
        buttons.forEach(b => { b.className = 'rounded-lg border px-4 py-2 text-sm font-semibold ' + (b.dataset.scope === id ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 bg-white text-slate-700'); });
        const level = scopeToLevel[id] || 3;
        document.getElementById('scopeLabel').textContent = 'Scope ' + level + ' of 5';
        [...document.querySelectorAll('#meter span')].forEach((s, i) => { s.className = 'h-1.5 w-8 rounded-full ' + (i < level ? 'bg-slate-900' : 'bg-slate-300'); });
      }
      buttons.forEach(b => b.addEventListener('click', () => setScope(b.dataset.scope)));
      setScope('genai-scope-3');
    </script>
  )}
  <script define:vars={{ panelData, serviceName: NAME[service] || service }}>
    (() => {
      const LABEL = { aws: 'AWS', customer: 'Customer', shared: 'Shared', model_provider: 'Model provider', not_stated: 'Not stated' };
      const ICON = { aws: '●', customer: '●', shared: '◆', model_provider: '▲', not_stated: '–' };
      const CLS = {
        aws: 'bg-[#dbeafe] text-[#1d4ed8]', customer: 'bg-[#ffedd5] text-[#9a3412]',
        shared: 'bg-[#f3e8ff] text-[#6b21a8]', model_provider: 'bg-[#d1fae5] text-[#047857]',
        not_stated: 'bg-[#e5e7eb] text-[#374151]',
      };
      const panel = document.getElementById('detail-panel');
      const buttons = Array.from(document.querySelectorAll('#controls-table button[data-detail]'));
      if (!panel || buttons.length === 0) return;

      function esc(value) {
        return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]);
      }
      function badge(owner) {
        const v = CLS[owner] ? owner : 'not_stated';
        return '<span class="inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 text-[11px] font-semibold whitespace-nowrap ' + CLS[v] + '">' +
          '<span aria-hidden="true" class="text-[0.7em] leading-none">' + ICON[v] + '</span>' + esc(LABEL[v]) + '</span>';
      }
      function markSelected(control) {
        buttons.forEach(b => {
          const on = b.dataset.detail === control;
          b.classList.toggle('ring-2', on);
          b.classList.toggle('ring-slate-900', on);
        });
      }
      function show(control) {
        markSelected(control);
        const e = panelData[control];
        if (!e) return;
        const source = e.url
          ? '<p class="mt-3 text-xs text-slate-500">Source: <a class="link break-all" href="' + esc(e.url) + '" target="_blank" rel="noopener">' + esc(e.url) + '</a> · Retrieved ' + esc(e.retrieved || '—') + ' · Reviewed ' + esc(e.reviewed || '—') + '</p>'
          : '';
        panel.innerHTML =
          '<p class="text-xs font-semibold uppercase tracking-wide text-slate-500">' + esc(serviceName) + ' · ' + esc(e.name) + '</p>' +
          '<div class="mt-2">' + badge(e.overall) + '</div>' +
          '<p class="mt-4 text-sm"><strong>AWS:</strong> ' + (e.aws ? esc(e.aws) : '—') + '</p>' +
          '<p class="mt-1 text-sm"><strong>You:</strong> ' + (e.customer ? esc(e.customer) : '—') + '</p>' +
          (e.modelProvider ? '<p class="mt-1 text-sm"><strong>Model provider:</strong> ' + esc(e.modelProvider) + '</p>' : '') +
          (e.quote ? '<blockquote class="mt-4 border-l-2 border-slate-300 pl-3 text-sm italic text-slate-600">“' + esc(e.quote) + '”</blockquote>' : '') +
          source +
          (e.rationale ? '<p class="mt-3 text-xs italic text-slate-500">' + esc(e.rationale) + '</p>' : '') +
          '<button id="copy-citation" type="button" class="mt-4 w-full rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">Copy citation</button>';

        const copy = document.getElementById('copy-citation');
        copy.addEventListener('click', async () => {
          const text = serviceName + ' · ' + e.name + ' · ' + (LABEL[e.overall] || 'Not stated') +
            ' · ' + (e.url || '') + ' · retrieved ' + (e.retrieved || '—') + ' · ' + location.href;
          try {
            await navigator.clipboard.writeText(text);
            copy.textContent = 'Copied';
          } catch {
            copy.textContent = 'Copy failed';
          }
        });

        if (window.innerWidth < 1024) {
          panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }

      buttons.forEach(b => b.addEventListener('click', () => show(b.dataset.detail)));
    })();
  </script>
</Base>