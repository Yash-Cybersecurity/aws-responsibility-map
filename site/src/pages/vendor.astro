---
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import fs from 'node:fs';
import yaml from 'js-yaml';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const glossary = yaml.load(fs.readFileSync('../data/vendor/glossary.yaml', 'utf8')).terms;
const questions = yaml.load(fs.readFileSync('../data/vendor/questions.yaml', 'utf8')).questions;
---
<Base title="Vendor view">
  <h1 class="text-3xl font-extrabold">Vendor view</h1>
  <p class="mt-2 text-slate-600 max-w-3xl">Building on AWS and answering customer security questionnaires? Use three columns: <strong>AWS</strong>, <strong>You (the vendor)</strong>, and <strong>Your customers</strong>. The dataset fills the first two; the third is yours to complete.</p>

  <div class="grid md:grid-cols-3 gap-4 mt-6">
    <div class="card p-5"><p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Column 1</p><div class="mt-2"><StatusBadge value="aws" /></div><p class="mt-2 text-sm text-slate-600">What AWS performs and secures.</p></div>
    <div class="card p-5"><p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Column 2</p><div class="mt-2"><StatusBadge value="customer" /></div><p class="mt-2 text-sm text-slate-600">What you, the vendor, configure.</p></div>
    <div class="card p-5 border-dashed"><p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Column 3</p><div class="mt-2"><span class="inline-flex rounded-md border border-dashed border-slate-400 px-2 py-1 text-xs font-semibold text-slate-600">Your customers</span></div><p class="mt-2 text-sm text-slate-600">Always filled in by you, never inferred.</p></div>
  </div>

  <section class="mt-8">
    <h2 class="text-xl font-bold">Common customer questions</h2>
    <div class="card mt-3 divide-y divide-slate-100">
      {questions.map(q => (
        <div class="px-5 py-3 flex flex-wrap items-center gap-2 text-sm">
          <span>{q.text}</span>
          <span class="ml-auto flex gap-1">{q.tags.map(t => <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] text-slate-600">{t}</span>)}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-8">
    <h2 class="text-xl font-bold">Glossary</h2>
    <dl class="card mt-3 divide-y divide-slate-100">
      {glossary.map(g => (
        <div class="px-5 py-4">
          <dt class="font-semibold text-sm">{g.term}</dt>
          <dd class="text-sm text-slate-600">{g.meaning} <em class="text-slate-500">e.g. {g.example}</em></dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="card p-5 mt-8">
    <h2 class="font-bold">Export</h2>
    <p class="mt-1 text-sm text-slate-600">Download the current dataset for your own workpapers.</p>
    <div class="mt-3 flex gap-3 text-sm font-semibold">
      <a class="rounded-lg border border-slate-300 px-4 py-2 hover:border-slate-900" href={`${base}data/export.csv`}>CSV</a>
      <a class="rounded-lg border border-slate-300 px-4 py-2 hover:border-slate-900" href={`${base}data/index.json`}>JSON</a>
    </div>
    <p class="mt-3 text-xs font-semibold text-slate-500">Unofficial, not an AWS statement. Verify against AWS documentation before submitting.</p>
  </section>
</Base>